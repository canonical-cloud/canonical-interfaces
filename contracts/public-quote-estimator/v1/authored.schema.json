{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canonical-cloud:public-quote-estimator:v1",
  "$defs": {
    "NineWeekSpeed": {
      "type": "object",
      "properties": {
        "weeks": { "type": "number", "const": 9 },
        "label": { "type": "string", "const": "9 weeks" },
        "baseUsd": { "type": "number", "const": 5000 },
        "note": { "type": "string" }
      },
      "required": ["weeks", "label", "baseUsd", "note"],
      "unevaluatedProperties": false
    },
    "FiveWeekSpeed": {
      "type": "object",
      "properties": {
        "weeks": { "type": "number", "const": 5 },
        "label": { "type": "string", "const": "5 weeks" },
        "baseUsd": { "type": "number", "const": 7500 },
        "note": { "type": "string" }
      },
      "required": ["weeks", "label", "baseUsd", "note"],
      "unevaluatedProperties": false
    },
    "ThreeWeekSpeed": {
      "type": "object",
      "properties": {
        "weeks": { "type": "number", "const": 3 },
        "label": { "type": "string", "const": "3 weeks" },
        "baseUsd": { "type": "number", "const": 10500 },
        "note": { "type": "string" }
      },
      "required": ["weeks", "label", "baseUsd", "note"],
      "unevaluatedProperties": false
    },
    "Speed": {
      "anyOf": [
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/NineWeekSpeed" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/FiveWeekSpeed" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/ThreeWeekSpeed" }
      ]
    },
    "Soc2Standard": { "type": "object", "properties": { "id": { "type": "string", "const": "soc2" }, "label": { "type": "string", "const": "SOC 2" }, "amountUsd": { "type": "number", "const": 0 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "Iso27001Standard": { "type": "object", "properties": { "id": { "type": "string", "const": "iso27001" }, "label": { "type": "string", "const": "ISO 27001" }, "amountUsd": { "type": "number", "const": 750 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "NistStandard": { "type": "object", "properties": { "id": { "type": "string", "const": "nist" }, "label": { "type": "string", "const": "NIST CSF / 800-series" }, "amountUsd": { "type": "number", "const": 500 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "GdprStandard": { "type": "object", "properties": { "id": { "type": "string", "const": "gdpr" }, "label": { "type": "string", "const": "GDPR" }, "amountUsd": { "type": "number", "const": 750 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "HipaaStandard": { "type": "object", "properties": { "id": { "type": "string", "const": "hipaa" }, "label": { "type": "string", "const": "HIPAA" }, "amountUsd": { "type": "number", "const": 1000 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "PciStandard": { "type": "object", "properties": { "id": { "type": "string", "const": "pci" }, "label": { "type": "string", "const": "PCI DSS" }, "amountUsd": { "type": "number", "const": 1000 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "FedRampStandard": { "type": "object", "properties": { "id": { "type": "string", "const": "fedramp" }, "label": { "type": "string", "const": "FedRAMP" }, "amountUsd": { "type": "number", "const": 1750 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "CisStandard": { "type": "object", "properties": { "id": { "type": "string", "const": "cis" }, "label": { "type": "string", "const": "CIS Controls" }, "amountUsd": { "type": "number", "const": 350 } }, "required": ["id", "label", "amountUsd"], "unevaluatedProperties": false },
    "Standard": {
      "anyOf": [
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/Soc2Standard" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/Iso27001Standard" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/NistStandard" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/GdprStandard" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/HipaaStandard" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/PciStandard" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/FedRampStandard" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/CisStandard" }
      ]
    },
    "AdvisoryDepth": { "type": "object", "properties": { "id": { "type": "string", "const": "advisory" }, "label": { "type": "string", "const": "Advisory" }, "amountUsd": { "type": "number", "const": 0 }, "note": { "type": "string" } }, "required": ["id", "label", "amountUsd", "note"], "unevaluatedProperties": false },
    "ManagedDepth": { "type": "object", "properties": { "id": { "type": "string", "const": "managed" }, "label": { "type": "string", "const": "Managed readiness" }, "amountUsd": { "type": "number", "const": 1500 }, "note": { "type": "string" } }, "required": ["id", "label", "amountUsd", "note"], "unevaluatedProperties": false },
    "RemediationDepth": { "type": "object", "properties": { "id": { "type": "string", "const": "remediation" }, "label": { "type": "string", "const": "Hands-on remediation" }, "amountUsd": { "type": "number", "const": 3000 }, "note": { "type": "string" } }, "required": ["id", "label", "amountUsd", "note"], "unevaluatedProperties": false },
    "DeliveryDepth": {
      "anyOf": [
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/AdvisoryDepth" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/ManagedDepth" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/RemediationDepth" }
      ]
    },
    "FocusedComplexity": { "type": "object", "properties": { "id": { "type": "string", "const": "focused" }, "label": { "type": "string", "const": "Focused scope" }, "amountUsd": { "type": "number", "const": 0 }, "note": { "type": "string" } }, "required": ["id", "label", "amountUsd", "note"], "unevaluatedProperties": false },
    "GrowingComplexity": { "type": "object", "properties": { "id": { "type": "string", "const": "growing" }, "label": { "type": "string", "const": "Growing environment" }, "amountUsd": { "type": "number", "const": 1000 }, "note": { "type": "string" } }, "required": ["id", "label", "amountUsd", "note"], "unevaluatedProperties": false },
    "ComplexComplexity": { "type": "object", "properties": { "id": { "type": "string", "const": "complex" }, "label": { "type": "string", "const": "Complex / regulated" }, "amountUsd": { "type": "number", "const": 2000 }, "note": { "type": "string" } }, "required": ["id", "label", "amountUsd", "note"], "unevaluatedProperties": false },
    "Complexity": {
      "anyOf": [
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/FocusedComplexity" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/GrowingComplexity" },
        { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/ComplexComplexity" }
      ]
    },
    "DefaultStandardId": {
      "anyOf": [
        { "type": "string", "const": "soc2" },
        { "type": "string", "const": "iso27001" }
      ]
    },
    "EstimatorDefaults": {
      "type": "object",
      "properties": {
        "speedWeeks": { "type": "number", "const": 5 },
        "standardIds": { "type": "array", "items": { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/DefaultStandardId" } },
        "deliveryDepthId": { "type": "string", "const": "managed" },
        "complexityId": { "type": "string", "const": "growing" }
      },
      "required": ["speedWeeks", "standardIds", "deliveryDepthId", "complexityId"],
      "unevaluatedProperties": false
    },
    "PublicQuoteEstimatorConfig": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "currency": { "type": "string", "const": "USD" },
        "estimateFloorUsd": { "type": "number", "const": 5000 },
        "estimateCeilingUsd": { "type": "number", "const": 15000 },
        "midpointFloorUsd": { "type": "number", "const": 5500 },
        "midpointCeilingUsd": { "type": "number", "const": 13500 },
        "roundToUsd": { "type": "number", "const": 500 },
        "lowerFactor": { "type": "number", "const": 0.9 },
        "upperFactor": { "type": "number", "const": 1.12 },
        "speeds": { "type": "array", "items": { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/Speed" } },
        "standards": { "type": "array", "items": { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/Standard" } },
        "deliveryDepths": { "type": "array", "items": { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/DeliveryDepth" } },
        "complexities": { "type": "array", "items": { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/Complexity" } },
        "defaults": { "$ref": "urn:canonical-cloud:public-quote-estimator:v1#/$defs/EstimatorDefaults" }
      },
      "required": ["schemaVersion", "currency", "estimateFloorUsd", "estimateCeilingUsd", "midpointFloorUsd", "midpointCeilingUsd", "roundToUsd", "lowerFactor", "upperFactor", "speeds", "standards", "deliveryDepths", "complexities", "defaults"],
      "unevaluatedProperties": false
    }
  }
}
