{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical.commercial-service-tier.v1.schema.json",
  "$defs": {
    "FoundationReadinessTier": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FoundationReadinessTier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "const": "foundation-readiness" },
        "name": { "type": "string", "const": "Foundation Readiness" },
        "monthlyUsd": { "type": "number", "const": 2500 }
      },
      "required": ["id", "name", "monthlyUsd"],
      "unevaluatedProperties": false
    },
    "ManagedReadinessTier": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ManagedReadinessTier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "const": "managed-readiness" },
        "name": { "type": "string", "const": "Managed Readiness" },
        "monthlyUsd": { "type": "number", "const": 7500 }
      },
      "required": ["id", "name", "monthlyUsd"],
      "unevaluatedProperties": false
    },
    "AssuranceEngineeringTier": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "AssuranceEngineeringTier",
      "type": "object",
      "properties": {
        "id": { "type": "string", "const": "assurance-engineering" },
        "name": { "type": "string", "const": "Assurance Engineering" },
        "monthlyUsd": { "type": "number", "const": 20000 }
      },
      "required": ["id", "name", "monthlyUsd"],
      "unevaluatedProperties": false
    },
    "ServiceTier": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ServiceTier",
      "anyOf": [
        { "$ref": "#/$defs/FoundationReadinessTier" },
        { "$ref": "#/$defs/ManagedReadinessTier" },
        { "$ref": "#/$defs/AssuranceEngineeringTier" }
      ]
    },
    "PublicationStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PublicationStatus",
      "anyOf": [
        { "type": "string", "const": "approved" },
        { "type": "string", "const": "proposed" },
        { "type": "string", "const": "retired" }
      ]
    },
    "ServiceTierCatalog": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ServiceTierCatalog",
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "publicationStatus": { "$ref": "#/$defs/PublicationStatus" },
        "currency": { "type": "string", "const": "USD" },
        "asOf": { "type": "string" },
        "tiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ServiceTier" }
        }
      },
      "required": ["schemaVersion", "publicationStatus", "currency", "asOf", "tiers"],
      "unevaluatedProperties": false
    }
  }
}
